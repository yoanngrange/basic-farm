# Base URL of the Express API (ag-api), no trailing slash
VITE_API_BASE_URL=http://localhost:3000/api

# Absolute origin used to build sitemap.xml/robots.txt URLs (no trailing slash)
SITE_ORIGIN=https://agjob.org

# Cloudflare Turnstile site key (public, safe to expose in generated HTML).
# If unset, the reveal-contact button is omitted from listing pages.
TURNSTILE_SITE_KEY=
