# --- Server ---
# Clever Cloud requires the app to listen on 8080 in production — set
# PORT=8080 as a Clever Cloud env var (never in this file).
PORT=3000
NODE_ENV=development

# --- Database (on Clever Cloud, linking a Postgres add-on sets POSTGRESQL_ADDON_URI;
# env.js falls back to it automatically, so DATABASE_URL doesn't need to be set there) ---
DATABASE_URL=postgres://user:password@localhost:5432/agjob_test

# --- Auth ---
JWT_SECRET=change-me-in-clever-cloud-env-vars
JWT_EXPIRES_IN=7d

# --- Logging ---
LOG_LEVEL=info

# --- CORS ---
CORS_ORIGIN=https://agjob.org

# --- Rate limiting (requests per 15 min window) ---
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CONTACT_MAX=30
RATE_LIMIT_REVEAL_MAX=15

# --- Captcha (Cloudflare Turnstile) — required in production, optional in dev/test ---
TURNSTILE_SECRET_KEY=

# --- Site rebuild trigger (keeps the static site, including sitemap.xml,
# in sync every time a listing is published/unpublished) ---
# Fine-grained GitHub PAT with "Contents: read/write" on the ag-web repo,
# or a classic PAT with the "repo" scope. If unset, rebuilds are skipped
# (logged) — the API keeps working, the static site just goes stale until
# the next manual/push-triggered deploy.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=your-org/ag-web
GITHUB_DISPATCH_EVENT_TYPE=listing-changed

# --- Email notifications (farmer gets notified on new contacts) ---
# Brevo SMTP relay — 300 emails/day free, no expiry, EU-hosted by default:
# comfortably covers this app's volume at zero cost.
# SMTP_USER is your Brevo account login email (not a domain-specific
# address). SMTP_PASS is an SMTP key generated in Brevo's dashboard under
# Settings > SMTP & API > SMTP — NOT your Brevo account password.
# Port 587 (STARTTLS) is standard; 465 (SSL) also works. Port 25 is not
# supported for client submission.
# If SMTP_HOST is unset, notifications are skipped (logged, never fails a request).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=
EMAIL_FROM=Ag Jobs <no-reply@your-verified-domain.com>
